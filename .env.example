# Phase 3 platform settings
PLATFORM_DB_URL=postgresql+psycopg://platform:platform@localhost:5433/platform
PLATFORM_JWT_SECRET=replace-with-random-32-byte-secret
PLATFORM_BCRYPT_ROUNDS=12
PLATFORM_DB_ECHO=false
PYTHONPATH=.

# --- Authentication -------------------------------------------------------
# Signing key for sign-in tokens (at least 32 bytes). If unset, the API
# generates a local development secret in .capstone_dev_jwt_secret.
# PLATFORM_JWT_SECRET is listed above.
PLATFORM_JWT_TTL_SECONDS=28800
# Role given to accounts registered after the first one (first = OWNER).
CAPSTONE_SIGNUP_ROLE=VIEWER
# Leave true. false re-enables the legacy X-User-Id header identity (tests only).
CAPSTONE_AUTH_REQUIRED=true
# Admin account created (or promoted) when the API starts. Admin = owner of
# every workspace. An existing account keeps its password.
CAPSTONE_ADMIN_EMAIL=pes.capstone.team189@gmail.com
CAPSTONE_ADMIN_PASSWORD=12345678

# --- Notifications (unset channels report "Not configured") ---------------
# Email can also be set up per workspace from Settings in the dashboard;
# workspace settings take priority over these.
DEMO_EMAIL_SENDER=pes.capstone.team189@gmail.com
# Gmail: a 16-character App Password (myaccount.google.com/apppasswords)
DEMO_EMAIL_PASSWORD=%Team189%
# Defaults to Gmail; set these for another provider.
SMTP_HOST=pes.capstone.team189@gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
# Key for encrypting SMTP passwords saved from Settings (32+ chars).
# Defaults to a key derived from PLATFORM_JWT_SECRET.
PLATFORM_CREDENTIAL_KEY=
# Optional override; otherwise alerts email every member of the workspace.
DEMO_EMAIL_RECIPIENT=
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
PAGERDUTY_ROUTING_KEY=
CAPSTONE_DASHBOARD_URL=http://127.0.0.1:5173
