@@ -0,0 +1,83 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { MemoryRouter } from 'react-router-dom';
+import { AuthContext, type AuthContextValue } from '../../auth/authContext';
+import type { Role } from '../../services/authApi';
+import UsersPage from './page';
+
+const authApi = vi.hoisted(() => ({
+  listMembers: vi.fn(),
+  addMember: vi.fn(),
+  updateMemberRole: vi.fn(),
+  removeMember: vi.fn(),
+}));
+
+vi.mock('../../services/authApi', async (importOriginal) => ({
+  ...(await importOriginal<typeof import('../../services/authApi')>()),
+  ...authApi,
+}));
+
+const members = [
+  { user_id: 'user-1', email: 'owner@example.com', role: 'OWNER' as Role, joined_at: '2026-10-26T10:00:00Z' },
+  { user_id: 'user-2', email: 'teammate@example.com', role: 'VIEWER' as Role, joined_at: '2026-10-26T11:00:00Z' },
+];
+
+function renderAs(role: Role) {
+  const value: AuthContextValue = {
+    status: 'authenticated',
+    session: { user: { user_id: role === 'OWNER' ? 'user-1' : 'user-2', email: 'x@example.com', role }, memberships: [] },
+    activeTenantId: 'google',
+    activeMembership: { tenant_id: 'google', tenant_name: 'Google', role },
+    role,
+    signIn: vi.fn(),
+    signUp: vi.fn(),
+    signOut: vi.fn(),
+    switchTenant: vi.fn(),
+    refresh: vi.fn().mockResolvedValue(undefined),
+  };
+  return render(
+    <MemoryRouter>
+      <AuthContext.Provider value={value}><UsersPage /></AuthContext.Provider>
+    </MemoryRouter>,
+  );
+}
+
+describe('UsersPage', () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+    authApi.listMembers.mockResolvedValue(members);
+  });
+
+  it('lets an owner change roles and add members', async () => {
+    authApi.updateMemberRole.mockResolvedValue({ ...members[1], role: 'OPERATOR' });
+    authApi.addMember.mockResolvedValue({ user_id: 'user-3', email: 'new@example.com', role: 'OPERATOR' });
+    renderAs('OWNER');
+
+    const roleSelect = await screen.findByLabelText('Role for teammate@example.com');
+    fireEvent.change(roleSelect, { target: { value: 'OPERATOR' } });
+    await waitFor(() => expect(authApi.updateMemberRole).toHaveBeenCalledWith('user-2', 'OPERATOR'));
+    expect(await screen.findByText('teammate@example.com is now operator')).toBeInTheDocument();
+
+    fireEvent.change(screen.getByLabelText('Email'), { target: { value: 'new@example.com' } });
+    fireEvent.change(screen.getByLabelText('Role'), { target: { value: 'OPERATOR' } });
+    fireEvent.click(screen.getByRole('button', { name: 'Add member' }));
+    await waitFor(() => expect(authApi.addMember).toHaveBeenCalledWith('new@example.com', 'OPERATOR'));
+  });
+
+  it('surfaces the last-owner guard from the API', async () => {
+    authApi.removeMember.mockRejectedValue(new Error('HTTP 409: A workspace needs at least one owner'));
+    renderAs('OWNER');
+
+    fireEvent.click((await screen.findAllByRole('button', { name: 'Remove' }))[0]);
+    fireEvent.click(screen.getByRole('button', { name: 'Remove member' }));
+    expect(await screen.findByText('A workspace needs at least one owner')).toBeInTheDocument();
+  });
+
+  it('is read-only for viewers', async () => {
+    renderAs('VIEWER');
+    expect(await screen.findByText('teammate@example.com')).toBeInTheDocument();
+    expect(screen.queryByLabelText('Role for teammate@example.com')).toBeNull();
+    expect(screen.queryByRole('button', { name: 'Add member' })).toBeNull();
+    expect(screen.getByText(/Only owners can add members/)).toBeInTheDocument();
+  });
+});
diff --git a/frontend/src/auth/AuthProvider.tsx b/frontend/src/auth/AuthProvider.tsx
new file mode 100644
index 0000000..1264e8e
--- /dev/null
+++ b/frontend/src/auth/AuthProvider.tsx
@@ -0,0 +1,154 @@
+import { useCallback, useEffect, useMemo, useState, type ReactNode } from 'react';
+import {
+  clearSession,
+  getAccessToken,
+  getActiveTenantId,
+  getStoredSessionJson,
+  getStoredUserId,
+  isMockMode,
+  SESSION_EVENT,
+  setActiveTenantId,
+  setStoredRole,
+  storeSession,
+} from '../services/apiClient';
+import {
+  fetchCurrentSession,
+  login,
+  register,
+  type AuthSession,
+} from '../services/authApi';
+import { MOCK_TENANTS } from '../services/mockData';
+import { AuthContext, type AuthContextValue, type AuthStatus } from './authContext';
+
+function readStoredSession(): AuthSession | null {
+  const raw = getStoredSessionJson();
+  if (raw) {
+    try {
+      return JSON.parse(raw) as AuthSession;
+    } catch {
+      return null;
+    }
+  }
+  // Mock-mode smoke tests seed only capstone.userId; give them a usable session.
+  const userId = getStoredUserId();
+  if (isMockMode() && userId) {
+    return {
+      user: { user_id: userId, email: `${userId}@mock.local`, role: 'OPERATOR' },
+      memberships: MOCK_TENANTS.map((tenant) => ({ tenant_id: tenant.id, tenant_name: tenant.name, role: 'OPERATOR' })),
+    };
+  }
+  return null;
+}
+
+function chooseTenant(session: AuthSession): string | null {
+  const current = getActiveTenantId();
+  if (current && session.memberships.some((item) => item.tenant_id === current)) return current;
+  return session.memberships[0]?.tenant_id ?? null;
+}
+
+export default function AuthProvider({ children }: { children: ReactNode }) {
+  const [session, setSession] = useState<AuthSession | null>(() => readStoredSession());
+  const [status, setStatus] = useState<AuthStatus>(() => {
+    if (!readStoredSession()) return 'anonymous';
+    return getAccessToken() ? 'loading' : 'authenticated';
+  });
+  const [activeTenantId, setActiveTenant] = useState<string | null>(() => getActiveTenantId());
+
+  const apply = useCallback((next: AuthSession, token: string | null) => {
+    const tenantId = chooseTenant(next);
+    const role = next.memberships.find((item) => item.tenant_id === tenantId)?.role ?? null;
+    if (tenantId) setActiveTenantId(tenantId);
+    storeSession({
+      token,
+      userId: next.user.user_id,
+      sessionJson: JSON.stringify({ user: next.user, memberships: next.memberships }),
+      role,
+    });
+    setSession(next);
+    setActiveTenant(tenantId);
+    setStatus('authenticated');
+  }, []);
+
+  const refresh = useCallback(async () => {
+    const token = getAccessToken();
+    if (!token) return;
+    try {
+      apply(await fetchCurrentSession(), token);
+    } catch {
+      clearSession();
+      setSession(null);
+      setStatus('anonymous');
+    }
+  }, [apply]);
+
+  // Revalidate a stored token once on load (it may have expired or been revoked).
+  useEffect(() => {
+    const token = getAccessToken();
+    if (!token || !getStoredUserId()) return undefined;
+    let cancelled = false;
+    fetchCurrentSession()
+      .then((next) => { if (!cancelled) apply(next, token); })
+      .catch(() => {
+        if (cancelled) return;
+        clearSession();
+        setSession(null);
+        setStatus('anonymous');
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [apply]);
+
+  // Stay in sync with other tabs and with apiClient clearing an expired session.
+  useEffect(() => {
+    const sync = () => {
+      const stored = readStoredSession();
+      setActiveTenant(getActiveTenantId());
+      if (!stored) {
+        setSession(null);
+        setStatus('anonymous');
+      }
+    };
+    window.addEventListener(SESSION_EVENT, sync);
+    window.addEventListener('storage', sync);
+    return () => {
+      window.removeEventListener(SESSION_EVENT, sync);
+      window.removeEventListener('storage', sync);
+    };
+  }, []);
+
+  const value = useMemo<AuthContextValue>(() => {
+    const activeMembership = session?.memberships.find((item) => item.tenant_id === activeTenantId) ?? null;
+    return {
+      status,
+      session,
+      activeTenantId,
+      activeMembership,
+      role: activeMembership?.role ?? null,
+      signIn: async (email, password) => {
+        const next = await login(email, password);
+        apply(next, next.access_token ?? null);
+        return next;
+      },
+      signUp: async (email, password) => {
+        const next = await register(email, password);
+        apply(next, next.access_token ?? null);
+        return next;
+      },
+      signOut: () => {
+        clearSession();
+        setSession(null);
+        setStatus('anonymous');
+      },
+      switchTenant: (tenantId: string) => {
+        const membership = session?.memberships.find((item) => item.tenant_id === tenantId);
+        setActiveTenantId(tenantId);
+        setStoredRole(membership?.role ?? null);
+        setActiveTenant(tenantId);
+      },
+      refresh,
+    };
+  }, [activeTenantId, apply, refresh, session, status]);
+
+  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
+}
diff --git a/frontend/src/auth/authContext.ts b/frontend/src/auth/authContext.ts
new file mode 100644
index 0000000..7f9844d
--- /dev/null
+++ b/frontend/src/auth/authContext.ts
@@ -0,0 +1,31 @@
+import { createContext, useContext } from 'react';
+import type { AuthSession, Membership, Role } from '../services/authApi';
+
+export type AuthStatus = 'loading' | 'authenticated' | 'anonymous';
+
+export interface AuthContextValue {
+  status: AuthStatus;
+  session: AuthSession | null;
+  activeTenantId: string | null;
+  activeMembership: Membership | null;
+  /** Role in the active workspace (null when not a member). */
+  role: Role | null;
+  signIn: (email: string, password: string) => Promise<AuthSession>;
+  signUp: (email: string, password: string) => Promise<AuthSession>;
+  signOut: () => void;
+  switchTenant: (tenantId: string) => void;
+  refresh: () => Promise<void>;
+}
+
+export const AuthContext = createContext<AuthContextValue | null>(null);
+
+export function useAuth(): AuthContextValue {
+  const value = useContext(AuthContext);
+  if (!value) throw new Error('useAuth must be used inside <AuthProvider>');
+  return value;
+}
+
+/** Read-only variant for components that also render outside the provider (tests). */
+export function useOptionalAuth(): AuthContextValue | null {
+  return useContext(AuthContext);
+}
