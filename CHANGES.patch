+    assert response.status_code == 201, response.text
+    body = response.json()
+    return {"Authorization": f"Bearer {body['access_token']}", "X-Tenant-Id": "google"}
+
+
+def test_unconfigured_channels_are_reported_as_such_and_never_as_sent(client):
